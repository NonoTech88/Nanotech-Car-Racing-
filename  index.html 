leftBtn.addEventListener(
  "pointerdown",
  e=>{
    e.preventDefault();

    buttonDown(-1,leftBtn);
  }
);

leftBtn.addEventListener(
  "pointerup",
  e=>{
    e.preventDefault();

    buttonUp(leftBtn);
  }
);

leftBtn.addEventListener(
  "pointercancel",
  ()=>{
    buttonUp(leftBtn);
  }
);

leftBtn.addEventListener(
  "pointerleave",
  ()=>{
    buttonUp(leftBtn);
  }
);


