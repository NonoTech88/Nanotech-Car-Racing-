<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>NonoTech Road Race</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  width:100%;
  height:100%;
  overflow:hidden;
  background:#000;
  touch-action:none;
  user-select:none;
}

#gameContainer{
  position:relative;
  width:100vw;
  height:100dvh;
  max-width:520px;
  margin:auto;
  overflow:hidden;
  background:#000;
}

canvas{
  display:block;
  width:100%;
  height:100%;
}

#splash,
#gameOver{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:#080808;
  z-index:20;
  transition:opacity .4s;
}

#gameOver{
  display:none;
  opacity:0;
  z-index:25;
}

#splash h1{
  font-family:'Press Start 2P',monospace;
  color:#ff8c1a;
  font-size:clamp(26px,9vw,52px);
  text-align:center;
  text-shadow:4px 4px #713900;
}

#splash p{
  margin-top:28px;
  color:#7CFC00;
  font-family:'Press Start 2P',monospace;
  font-size:clamp(9px,3vw,15px);
  animation:blink 1s infinite;
}

@keyframes blink{
  50%{opacity:0}
}

#gameOver h1{
  font-family:'Press Start 2P',monospace;
  color:#ff3030;
  font-size:clamp(20px,7vw,40px);
  text-shadow:4px 4px #620000;
}

#gameOver p{
  margin-top:20px;
  font-family:'Press Start 2P',monospace;
  color:#fff;
  font-size:clamp(10px,3vw,15px);
}

#finalKm{
  color:#7CFC00;
}

#startBtn{
  margin-top:30px;
  padding:14px 28px;
  background:#ff8c1a;
  color:#111;
  border:3px solid #c65a00;
  border-radius:6px;
  font-family:'Press Start 2P',monospace;
  font-size:clamp(11px,3.5vw,17px);
}

#hud{
  position:absolute;
  top:0;
  left:0;
  right:0;
  z-index:5;
  display:flex;
  justify-content:space-between;
  padding:12px;
  pointer-events:none;
  font-family:'Press Start 2P',monospace;
}

.hud-box{
  min-width:72px;
  padding:6px 8px;
  background:rgba(0,0,0,.58);
  border:2px solid #ffb347;
  border-radius:4px;
}

.hud-label{
  color:#7CFC00;
  font-size:clamp(7px,2vw,10px);
}

.hud-value{
  color:#fff;
  margin-top:4px;
  font-size:clamp(12px,4vw,21px);
}

.center{text-align:center}
.right{text-align:right}

#controls{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  z-index:6;
  display:flex;
  justify-content:space-between;
  padding:20px;
}

.ctrl-btn{
  width:clamp(58px,17vw,82px);
  height:clamp(58px,17vw,82px);
  display:flex;
  justify-content:center;
  align-items:center;
  border-radius:50%;
  border:2px solid rgba(255,255,255,.45);
  background:rgba(255,255,255,.14);
  color:#fff;
  font-size:clamp(20px,6vw,30px);
}

.ctrl-btn.active{
  background:rgba(255,140,26,.5);
  border-color:#ff8c1a;
}

#crashFlash{
  position:absolute;
  inset:0;
  z-index:8;
  background:red;
  opacity:0;
  pointer-events:none;
}

#crashText{
  position:absolute;
  top:44%;
  left:50%;
  transform:translate(-50%,-50%);
  z-index:9;
  color:#fff;
  font-family:'Press Start 2P',monospace;
  font-size:clamp(14px,5vw,27px);
  text-shadow:3px 3px #a00000;
  opacity:0;
  pointer-events:none;
}
</style>
</head>

<body>

<div id="gameContainer">

<canvas id="game"></canvas>

<div id="crashFlash"></div>
<div id="crashText">CRASH!</div>

<div id="hud">
  <div class="hud-box">
    <div class="hud-label">KM</div>
    <div class="hud-value" id="kmVal">0000.0</div>
  </div>

  <div class="hud-box center">
    <div class="hud-label">HITS</div>
    <div class="hud-value" id="hitsVal">0/5</div>
  </div>

  <div class="hud-box right">
    <div class="hud-label">SPEED</div>
    <div class="hud-value" id="speedVal">040</div>
  </div>
</div>

<div id="controls">
  <div class="ctrl-btn" id="leftBtn">◀</div>
  <div class="ctrl-btn" id="rightBtn">▶</div>
</div>

<div id="splash">
  <h1>NonoTech</h1>
  <p>TAP TO START</p>
</div>

<div id="gameOver">
  <h1>GAME OVER</h1>
  <p>KM: <span id="finalKm">0.0</span></p>
  <button id="startBtn">START</button>
</div>

</div>

<script>
(function(){

const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");

const container=document.getElementById("gameContainer");

const splash=document.getElementById("splash");
const gameOver=document.getElementById("gameOver");
const startBtn=document.getElementById("startBtn");

const kmVal=document.getElementById("kmVal");
const speedVal=document.getElementById("speedVal");
const hitsVal=document.getElementById("hitsVal");
const finalKm=document.getElementById("finalKm");

const leftBtn=document.getElementById("leftBtn");
const rightBtn=document.getElementById("rightBtn");

const crashFlash=document.getElementById("crashFlash");
const crashText=document.getElementById("crashText");


/* =========================
   GAME SETTINGS
========================= */

const MAX_SPEED=260;
const START_SPEED=40;
const ACCEL=4.2;

const STEER_SPEED=430;

const KM_SCALE=8;

const MAX_CRASHES=5;

const MAX_NPC_ON_SCREEN=4;


/* =========================
   CANVAS
========================= */

let dpr=Math.max(2,Math.min(3,window.devicePixelRatio||1));

let W=0;
let H=0;

let roadLeft=0;
let roadRight=0;
let roadWidth=0;

function resize(){

  const rect=container.getBoundingClientRect();

  W=rect.width;
  H=rect.height;

  canvas.width=Math.round(W*dpr);
  canvas.height=Math.round(H*dpr);

  ctx.setTransform(dpr,0,0,dpr,0,0);

  roadLeft=W*.22;
  roadRight=W*.78;
  roadWidth=roadRight-roadLeft;

  player.w=roadWidth*.19;
  player.h=player.w*1.35;

  player.y=H*.76;

  player.x=clamp(
    player.x,
    roadLeft+4,
    roadRight-player.w-4
  );
}

window.addEventListener("resize",resize);


/* =========================
   HELPERS
========================= */

function clamp(v,min,max){
  return Math.max(min,Math.min(max,v));
}

function rand(min,max){
  return min+Math.random()*(max-min);
}

function rr(x,y,w,h,r){

  r=Math.min(r,w/2,h/2);

  ctx.beginPath();

  ctx.moveTo(x+r,y);

  ctx.arcTo(x+w,y,x+w,y+h,r);

  ctx.arcTo(x+w,y+h,x,y+h,r);

  ctx.arcTo(x,y+h,x,y,r);

  ctx.arcTo(x,y,x+w,y,r);

  ctx.closePath();
}


/* =========================
   PLAYER / NPC CARS
========================= */

function drawSedan(x,y,w,h,body,accent){

  ctx.save();

  ctx.shadowColor="rgba(0,0,0,.4)";
  ctx.shadowBlur=7;
  ctx.shadowOffsetY=3;

  ctx.fillStyle=body;

  rr(x,y,w,h,w*.16);
  ctx.fill();

  ctx.restore();

  ctx.fillStyle="rgba(0,0,0,.15)";

  rr(x,y,w*.15,h,w*.07);
  ctx.fill();

  rr(x+w*.85,y,w*.15,h,w*.07);
  ctx.fill();

  ctx.fillStyle="rgba(170,220,255,.9)";

  rr(
    x+w*.16,
    y+h*.1,
    w*.68,
    h*.2,
    w*.06
  );

  ctx.fill();

  ctx.fillStyle=accent;

  rr(
    x+w*.1,
    y+h*.36,
    w*.8,
    h*.24,
    w*.05
  );

  ctx.fill();

  ctx.fillStyle="rgba(170,220,255,.7)";

  rr(
    x+w*.18,
    y+h*.64,
    w*.64,
    h*.14,
    w*.05
  );

  ctx.fill();

  ctx.fillStyle="#111";

  rr(x-w*.09,y+h*.1,w*.15,h*.22,w*.04);
  ctx.fill();

  rr(x+w*.94,y+h*.1,w*.15,h*.22,w*.04);
  ctx.fill();

  rr(x-w*.09,y+h*.66,w*.15,h*.22,w*.04);
  ctx.fill();

  rr(x+w*.94,y+h*.66,w*.15,h*.22,w*.04);
  ctx.fill();

  ctx.fillStyle="#fff59d";

  rr(x+w*.08,y+h*.02,w*.18,h*.05,h*.02);
  ctx.fill();

  rr(x+w*.74,y+h*.02,w*.18,h*.05,h*.02);
  ctx.fill();

  ctx.fillStyle="#e53935";

  rr(x+w*.08,y+h*.93,w*.18,h*.05,h*.02);
  ctx.fill();

  rr(x+w*.74,y+h*.93,w*.18,h*.05,h*.02);
  ctx.fill();
}


function drawTruck(x,y,w,h,body,accent,cab){

  ctx.fillStyle=body;

  rr(
    x,
    y+h*.24,
    w,
    h*.72,
    w*.1
  );

  ctx.fill();

  ctx.fillStyle=cab||accent;

  rr(
    x+w*.08,
    y,
    w*.84,
    h*.22,
    w*.1
  );

  ctx.fill();

  ctx.fillStyle="rgba(170,220,255,.9)";

  rr(
    x+w*.16,
    y+h*.03,
    w*.68,
    h*.13,
    w*.04
  );

  ctx.fill();

  ctx.fillStyle=accent;

  ctx.fillRect(
    x,
    y+h*.5,
    w,
    h*.08
  );

  ctx.fillStyle="#111";

  rr(x-w*.07,y+h*.14,w*.13,h*.16,w*.04);
  ctx.fill();

  rr(x+w*.94,y+h*.14,w*.13,h*.16,w*.04);
  ctx.fill();

  rr(x-w*.07,y+h*.72,w*.13,h*.18,w*.04);
  ctx.fill();

  rr(x+w*.94,y+h*.72,w*.13,h*.18,w*.04);
  ctx.fill();

  ctx.fillStyle="#fff59d";

  rr(x+w*.08,y+h*.01,w*.16,h*.04,h*.015);
  ctx.fill();

  rr(x+w*.76,y+h*.01,w*.16,h*.04,h*.015);
  ctx.fill();

  ctx.fillStyle="#e53935";

  rr(x+w*.06,y+h*.94,w*.16,h*.05,h*.02);
  ctx.fill();

  rr(x+w*.78,y+h*.94,w*.16,h*.05,h*.02);
  ctx.fill();
}


function drawAuto(x,y,w,h,body,accent){

  ctx.fillStyle="#171717";

  rr(
    x+w*.14,
    y+h*.55,
    w*.72,
    h*.4,
    w*.08
  );

  ctx.fill();

  ctx.fillStyle=body;

  ctx.beginPath();

  ctx.moveTo(x+w*.06,y+h*.55);

  ctx.lineTo(x+w*.06,y+h*.24);

  ctx.quadraticCurveTo(
    x+w*.06,
    y,
    x+w*.5,
    y
  );

  ctx.quadraticCurveTo(
    x+w*.94,
    y,
    x+w*.94,
    y+h*.24
  );

  ctx.lineTo(x+w*.94,y+h*.55);

  ctx.closePath();

  ctx.fill();

  ctx.fillStyle="rgba(15,15,15,.65)";

  rr(
    x+w*.14,
    y+h*.2,
    w*.72,
    h*.28,
    w*.06
  );

  ctx.fill();

  ctx.fillStyle=accent;

  ctx.fillRect(
    x+w*.06,
    y+h*.5,
    w*.88,
    h*.07
  );

  ctx.fillStyle="#111";

  rr(x-w*.05,y+h*.62,w*.13,h*.22,w*.04);
  ctx.fill();

  rr(x+w*.92,y+h*.62,w*.13,h*.22,w*.04);
  ctx.fill();

  ctx.fillStyle="#e53935";

  rr(
    x+w*.38,
    y+h*.92,
    w*.24,
    h*.05,
    h*.02
  );

  ctx.fill();
}


function drawSupra(x,y,w,h){

  const body="#ff8c1a";
  const accent="#c65a00";

  ctx.save();

  ctx.shadowColor="rgba(0,0,0,.45)";
  ctx.shadowBlur=9;
  ctx.shadowOffsetY=4;

  ctx.fillStyle=body;

  rr(x,y,w,h,w*.14);
  ctx.fill();

  ctx.restore();

  ctx.fillStyle="rgba(0,0,0,.2)";

  rr(x,y,w*.17,h,w*.08);
  ctx.fill();

  rr(x+w*.83,y,w*.17,h,w*.08);
  ctx.fill();

  ctx.fillStyle="rgba(170,220,255,.95)";

  rr(
    x+w*.2,
    y+h*.18,
    w*.6,
    h*.16,
    w*.06
  );

  ctx.fill();

  ctx.fillStyle=accent;

  rr(
    x+w*.16,
    y+h*.36,
    w*.68,
    h*.2,
    w*.05
  );

  ctx.fill();

  ctx.fillStyle="rgba(170,220,255,.7)";

  rr(
    x+w*.22,
    y+h*.6,
    w*.56,
    h*.12,
    w*.05
  );

  ctx.fill();

  /* spoiler */

  ctx.fillStyle="#171717";

  rr(
    x+w*.05,
    y+h*.78,
    w*.9,
    h*.05,
    h*.02
  );

  ctx.fill();

  ctx.fillStyle="#111";

  rr(x-w*.1,y+h*.12,w*.16,h*.2,w*.05);
  ctx.fill();

  rr(x+w*.94,y+h*.12,w*.16,h*.2,w*.05);
  ctx.fill();

  rr(x-w*.1,y+h*.66,w*.16,h*.22,w*.05);
  ctx.fill();

  rr(x+w*.94,y+h*.66,w*.16,h*.22,w*.05);
  ctx.fill();

  ctx.fillStyle="#fff59d";

  rr(x+w*.1,y+h*.01,w*.16,h*.05,h*.02);
  ctx.fill();

  rr(x+w*.74,y+h*.01,w*.16,h*.05,h*.02);
  ctx.fill();

  ctx.fillStyle="#e53935";

  rr(x+w*.1,y+h*.9,w*.16,h*.05,h*.02);
  ctx.fill();

  rr(x+w*.74,y+h*.9,w*.16,h*.05,h*.02);
  ctx.fill();
}


function drawVehicle(o){

  if(o.type==="truck"){
    drawTruck(
      o.x,o.y,o.w,o.h,
      o.body,o.accent,o.cab
    );
  }

  else if(o.type==="auto"){
    drawAuto(
      o.x,o.y,o.w,o.h,
      o.body,o.accent
    );
  }

  else{
    drawSedan(
      o.x,o.y,o.w,o.h,
      o.body,o.accent
    );
  }
}


/* =========================
   GAME STATE
========================= */

let player={
  x:0,
  y:0,
  w:0,
  h:0
};

let obstacles=[];

let speed=START_SPEED;
let km=0;

let spawnTimer=1;

let scrollOffset=0;

let invulnerable=0;

let crashCount=0;

let running=false;

let steerDir=0;

let dragging=false;
let dragTargetX=null;


/* =========================
   NPC TYPES
========================= */

const NPC_TYPES=[

  {
    type:"sedan",
    body:"#1c5fb0",
    accent:"#0d2f57",
    wRatio:.17,
    hMul:1.55
  },

  {
    type:"sedan",
    body:"#c9c9c9",
    accent:"#3a3a3a",
    wRatio:.17,
    hMul:1.55
  },

  {
    type:"sedan",
    body:"#f2f2f2",
    accent:"#b71c1c",
    wRatio:.17,
    hMul:1.55
  },

  {
    type:"truck",
    body:"#e6e6e6",
    accent:"#1c5fb0",
    cab:"#1c5fb0",
    wRatio:.24,
    hMul:1.9
  },

  {
    type:"auto",
    body:"#ffd400",
    accent:"#111",
    wRatio:.13,
    hMul:1.35
  }

];

let lastType=-1;


/* =========================
   SPAWN NPC
========================= */

function spawnObstacle(){

  let index;

  do{
    index=Math.floor(
      Math.random()*NPC_TYPES.length
    );
  }
  while(
    index===lastType &&
    NPC_TYPES.length>1
  );

  lastType=index;

  const choice=NPC_TYPES[index];

  const w=roadWidth*choice.wRatio;
  const h=w*choice.hMul;

  const laneX=clamp(
    rand(
      roadLeft+5,
      roadRight-w-5
    ),
    roadLeft+5,
    roadRight-w-5
  );

  /*
    IMPORTANT:
    Every NPC gets its own speed.
    So they move straight instead of
    being attached to road scroll.
  */

  const npcSpeed=rand(100,190);

  obstacles.push({

    x:laneX,

    laneX:laneX,

    y:-h-20,

    w:w,
    h:h,

    type:choice.type,

    body:choice.body,

    accent:choice.accent,

    cab:choice.cab,

    speed:npcSpeed

  });

  const gapFactor=
    1-(speed/MAX_SPEED)*.35;

  spawnTimer=
    rand(1.1,2.1)*gapFactor;
}


/* =========================
   COLLISION
========================= */

function overlap(a,b){

  const padding=5;

  return(

    a.x+padding <
    b.x+b.w-padding &&

    a.x+a.w-padding >
    b.x+padding &&

    a.y+padding <
    b.y+b.h-padding &&

    a.y+a.h-padding >
    b.y+padding

  );
}


/* =========================
   CRASH
========================= */

function triggerCrash(){

  crashCount++;

  hitsVal.textContent=
    crashCount+"/"+MAX_CRASHES;

  crashFlash.style.transition="none";
  crashFlash.style.opacity=".55";

  crashText.style.transition="none";
  crashText.style.opacity="1";

  setTimeout(()=>{

    crashFlash.style.transition=
      "opacity .45s ease";

    crashFlash.style.opacity="0";

    crashText.style.transition=
      "opacity .7s ease";

    crashText.style.opacity="0";

  },50);


  if(crashCount>=MAX_CRASHES){

    gameOverScreen();

    return;
  }

  invulnerable=1.2;

  speed=Math.max(
    START_SPEED,
    speed*.5
  );
}


/* =========================
   GAME OVER
========================= */

function gameOverScreen(){

  running=false;

  finalKm.textContent=
    km.toFixed(1);

  gameOver.style.display="flex";

  requestAnimationFrame(()=>{

    gameOver.style.opacity="1";

  });
}


/* =========================
   RESET
========================= */

function resetGame(){

  speed=START_SPEED;

  km=0;

  crashCount=0;

  obstacles=[];

  spawnTimer=1;

  scrollOffset=0;

  invulnerable=0;

  steerDir=0;

  dragging=false;

  dragTargetX=null;

  player.x=
    roadLeft+
    roadWidth/2-
    player.w/2;

  hitsVal.textContent="0/5";

  kmVal.textContent="0000.0";

  speedVal.textContent="040";

  gameOver.style.opacity="0";

  setTimeout(()=>{

    gameOver.style.display="none";

  },400);

  running=true;

  lastTime=performance.now();

  requestAnimationFrame(loop);
}


/* =========================
   UPDATE
========================= */

function update(dt){

  /*
    Player speed
  */

  speed=Math.min(
    MAX_SPEED,
    speed+ACCEL*dt
  );

  /*
    Distance
  */

  km +=
    (speed*dt*KM_SCALE)/3600;

  /*
    Road animation
  */

  const roadScroll=
    55+speed*1.55;

  scrollOffset+=
    roadScroll*dt;


  /* PLAYER STEERING */

  if(
    dragging &&
    dragTargetX!==null
  ){

    const target=
      dragTargetX-player.w/2;

    player.x +=
      (target-player.x)*
      Math.min(1,dt*12);

  }

  else if(steerDir!==0){

    player.x +=
      steerDir*
      STEER_SPEED*
      dt;

  }

  player.x=clamp(
    player.x,
    roadLeft+3,
    roadRight-player.w-3
  );


  /*
    NPC movement
    ------------------
    They move straight
    with their OWN speed.
  */

  for(
    let i=obstacles.length-1;
    i>=0;
    i--
  ){

    const o=obstacles[i];

    o.y +=
      o.speed*dt;

    /*
      Keep exact lane.
      No side-to-side movement.
    */

    o.x=o.laneX;


    if(
      o.y >
      H+o.h+30
    ){

      obstacles.splice(i,1);

    }

  }


  /* SPAWN */

  spawnTimer-=dt;

  if(spawnTimer<=0){

    if(
      obstacles.length<
      MAX_NPC_ON_SCREEN
    ){

      spawnObstacle();

    }
    else{

      spawnTimer=.25;

    }

  }


  /* COLLISION */

  if(invulnerable>0){

    invulnerable-=dt;

  }
  else{

    for(
      let i=0;
      i<obstacles.length;
      i++
    ){

      if(
        overlap(
          player,
          obstacles[i]
        )
      ){

        obstacles.splice(i,1);

        triggerCrash();

        break;
      }

    }

  }


  /* HUD */

  kmVal.textContent=
    km.toFixed(1).padStart(6,"0");

  speedVal.textContent=
    String(
      Math.round(speed)
    ).padStart(3,"0");

}


/* =========================
   ROAD
========================= */

function drawRoad(){

  /*
    Grass
  */

  ctx.fillStyle="#3c9c3c";

  ctx.fillRect(
    0,0,W,H
  );


  /*
    Road
  */

  ctx.fillStyle="#565656";

  ctx.fillRect(
    roadLeft,
    0,
    roadWidth,
    H
  );


  /*
    Road shoulders
  */

  const shoulder=
    Math.max(
      6,
      roadWidth*.02
    );

  ctx.fillStyle="#ddd";

  ctx.fillRect(
    roadLeft-shoulder,
    0,
    shoulder,
    H
  );

  ctx.fillRect(
    roadRight,
    0,
    shoulder,
    H
  );


  /*
    Black shoulder ticks
  */

  ctx.fillStyle="#111";

  const tickPeriod=36;

  let ty=
    -tickPeriod+
    (scrollOffset%tickPeriod);

  while(ty<H){

    ctx.fillRect(
      roadLeft-shoulder,
      ty,
      shoulder,
      tickPeriod*.5
    );

    ctx.fillRect(
      roadRight,
      ty,
      shoulder,
      tickPeriod*.5
    );

    ty+=tickPeriod;

  }


  /*
    Center line
  */

  ctx.fillStyle="#f4f4f4";

  const dashH=42;
  const gap=30;
  const period=dashH+gap;

  let dy=
    -period+
    (scrollOffset%period);

  const dashW=
    Math.max(
      4,
      roadWidth*.02
    );

  const center=
    roadLeft+
    roadWidth/2-
    dashW/2;

  while(dy<H){

    ctx.fillRect(
      center,
      dy,
      dashW,
      dashH
    );

    dy+=period;

  }

}


/* =========================
   DRAW
========================= */

function draw(){

  drawRoad();


  /*
    NPC vehicles
  */

  for(
    const o of obstacles
  ){

    drawVehicle(o);

  }


  /*
    Player blinking after crash
  */

  if(
    invulnerable>0 &&
    Math.floor(
      invulnerable*18
    )%2===0
  ){

    return;

  }

  drawSupra(
    player.x,
    player.y,
    player.w,
    player.h
  );

}


/* =========================
   GAME LOOP
========================= */

let lastTime=0;

function loop(t){

  if(!running)
    return;

  const dt=Math.min(
    .05,
    (t-lastTime)/1000||0
  );

  lastTime=t;

  update(dt);

  draw();

  requestAnimationFrame(loop);
}


/* =========================
   START GAME
========================= */

function startGame(){

  if(running)
    return;

  splash.style.opacity="0";

  setTimeout(()=>{

    splash.style.display="none";

  },400);

  resetGame();

}


/* =========================
   TOUCH / BUTTON CONTROLS
========================= */

function buttonDown(dir,btn){

  steerDir=dir;

  btn.classList.add("active");

}

function buttonUp(btn){

  if(
    steerDir===-1 &&
    btn===leftBtn
  ){
    steerDir=0;
  }

  if(
    steerDir===1 &&
    btn===rightBtn
  ){
    steerDir=0;
  }

  btn.classList.remove("active");

}


